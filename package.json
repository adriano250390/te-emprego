{
  "name": "te-emprego-front-react",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    // Mantenha seus scripts customizados
    "dev": "node scripts/start.js",
    "build": "node scripts/build.js",
    "test": "node scripts/test.js",
    "start": "node serve"
  },
  "dependencies": {
    "@babel/core": "^7.22.0",
    "@svgr/webpack": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^5.59.2",
    "@typescript-eslint/parser": "^5.59.2",
    
    // Babel e Webpack
    "babel-jest": "^29.5.0",
    "babel-loader": "^9.1.2",
    
    // Permite import nomeado de assets (se você ainda usar)
    "babel-plugin-named-asset-import": "^1.0.0",
    
    // React e bibliotecas relacionadas
    "react": "^18.2.0",
    "react-app-polyfill": "^3.0.0", 
    "react-dev-utils": "^12.0.0", 
    "react-dom": "^18.2.0",
    "react-redux": "^8.0.5",
    "react-router-dom": "^6.11.2",
    "react-transition-group": "^4.4.5",
    
    // Redux
    "redux": "^4.2.1",
    "redux-saga": "^1.2.3",
    
    // Reactotron (se realmente usar)
    "reactotron-react-js": "^5.0.2",
    "reactotron-redux": "^3.2.0",
    "reactotron-redux-saga": "^4.2.3",
    
    // Styled Components
    "styled-components": "^5.3.9",
    
    // Ícones
    "material-icons-react": "^1.1.3",
    
    // Bootstrap grid (pode ser substituído por bootstrap^5.3.0 se desejado)
    "bootstrap-4-grid": "^3.0.0",
    
    // Ferramentas de build
    "css-loader": "^6.7.3",
    "style-loader": "^3.3.1",
    "sass-loader": "^13.3.2",
    "mini-css-extract-plugin": "^2.7.5",
    "file-loader": "^6.2.0",
    "url-loader": "^4.1.1",
    
    // Webpack & plugins
    "webpack": "^5.76.0",
    "webpack-cli": "^5.0.1",
    "webpack-dev-server": "^4.13.3",
    "webpack-manifest-plugin": "^4.1.1",
    "html-webpack-plugin": "^5.5.0",
    
    // Otimização de CSS (substitui optimize-css-assets-webpack-plugin)
    "css-minimizer-webpack-plugin": "^4.2.2",
    
    // Para PWA e service workers se necessário
    "workbox-webpack-plugin": "^7.0.0",
    
    // Outras dependências
    "dotenv": "^16.0.3",
    "dotenv-expand": "^9.0.0",
    "fs-extra": "^11.1.0",
    "is-wsl": "^2.2.0",
    "resolve": "^1.22.3",
    "semver": "^7.5.4",
    "prop-types": "^15.8.1",
    "camelcase": "^7.0.1",
    
    // Pós-processamento de CSS
    "postcss-loader": "^7.0.2",
    "postcss-preset-env": "^7.8.3",
    "postcss-normalize": "^10.0.1",
    "postcss-flexbugs-fixes": "^5.0.2"
  },
  "devDependencies": {
    // ESLint e configurações
    "eslint": "^8.34.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.6.0",
    "eslint-config-react-app": "^7.0.1",
    "eslint-loader": "^4.0.2",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsx-a11y": "^6.7.1",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    
    // Formatação de código
    "prettier": "^3.1.0",
    
    // Commitlint (conventional commits)
    "cz-conventional-changelog": "^3.3.0",
    
    // Testes
    "jest": "^29.5.0",
    "jest-environment-jsdom": "^29.5.0",
    "jest-watch-typeahead": "^2.2.0",
    
    // Se estiver usando TypeScript (opcional)
    // "typescript": "^4.9.5"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "airbnb",
      "prettier"
    ],
    "plugins": [
      "react",
      "react-hooks",
      "prettier"
    ],
    "rules": {
      // Regras de exemplo; personalize conforme necessidade
      "prettier/prettier": ["error"],
      "react/jsx-filename-extension": [1, { "extensions": [".js", ".jsx", ".ts", ".tsx"] }],
      "import/no-unresolved": 0
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx,ts,tsx}",
      "!src/**/*.d.ts"
    ],
    "setupFiles": [
      "react-app-polyfill/jsdom"
    ],
    "setupFilesAfterEnv": [],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.{js,jsx,ts,tsx}",
      "<rootDir>/src/**/*.{spec,test}.{js,jsx,ts,tsx}"
    ],
    // Agora o Jest já traz o jsdom atual integrado
    "testEnvironment": "jsdom",
    "transform": {
      "^.+\\.(js|jsx|ts|tsx)$": "babel-jest",
      "^.+\\.css$": "<rootDir>/config/jest/cssTransform.js",
      "^(?!.*\\.(js|jsx|ts|tsx|css|json)$)": "<rootDir>/config/jest/fileTransform.js"
    },
    "transformIgnorePatterns": [
      "[/\\\\]node_modules[/\\\\].+\\.(js|jsx|ts|tsx)$",
      "^.+\\.module\\.(css|sass|scss)$"
    ],
    "modulePaths": [],
    "moduleNameMapper": {
      "^react-native$": "react-native-web",
      "^.+\\.module\\.(css|sass|scss)$": "identity-obj-proxy"
    },
    "moduleFileExtensions": [
      "web.js",
      "js",
      "web.ts",
      "ts",
      "web.tsx",
      "tsx",
      "json",
      "web.jsx",
      "jsx",
      "node"
    ],
    "watchPlugins": [
      "jest-watch-typeahead/filename",
      "jest-watch-typeahead/testname"
    ]
  },
  "babel": {
    "presets": [
      "react-app"
    ]
  }
}
